# Firebase web-app config for online saving (Firebase console → Project settings → Your apps).
# Copy to .env.local for local dev; set the same names in Vercel → Settings → Environment Variables.
# Leave them unset and the app works as before, with no online saving.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
